#!/usr/bin/env bash

set -o errexit
set -o errtrace

SOURCEURL='https://netapi.com/netapi_top1mln.csv'

cargo build --release -p sectxt

tmp_directory="$(mktemp -d)"

exit_handler() {
	rm -r "$tmp_directory"
}

trap exit_handler EXIT

curl \
	--disable \
	--location \
	--max-time 60 \
	--output "$tmp_directory/top-1m.csv" \
	"$SOURCEURL"

xsv select 2 "$tmp_directory/top-1m.csv" | tail -n +2 | sort -u > "$tmp_directory/top.txt"

./target/release/sectxt --threads 50 --timeout 5 --quiet < "$tmp_directory/top.txt"
